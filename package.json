{
	"name": "tether",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:docker": "vitest run --project docker",
		"test:spikes": "vitest run --config vitest.spikes.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/pi-env": "1.4.0",
		"@types/node": "22.20.5",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
